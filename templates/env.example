# ~/.config/webapp-bootstrap/.env — fill once, used by every /webapp-bootstrap run.
# chmod 600 this file. Instructions for obtaining each value are inline.

# ============================= Hetzner VPS ==================================
# The only address you need: the server's Tailscale IP or MagicDNS name.
#   GET IT: run `tailscale status` on this machine and find the server's row
#   (e.g. 100.64.0.10), or use its MagicDNS name (myserver.tailXXXXXX.ts.net)
#   which survives IP reassignment. Verify: ssh <user>@<host> true
VPS_SSH_HOST=
# The SSH user Kamal connects as (root SSH is disabled on the VPS).
VPS_SSH_USER=
# Public IP for Cloudflare DNS is auto-discovered from the server at run time
# (ssh + `curl -4 ifconfig.me`). Set only to override (e.g. load balancer).
VPS_PUBLIC_IP=

# ============================= Cloudflare ===================================
#   GET TOKEN: dash.cloudflare.com -> profile icon (top right) -> My Profile
#   -> API Tokens -> Create Token -> Create Custom Token. Permissions (4 rows):
#     Zone    / Zone               / Edit
#     Zone    / DNS                / Edit
#     Zone    / Zone Settings      / Edit
#     Account / Workers R2 Storage / Edit   (creates the per-site bucket)
#   Account Resources: Include -> your account.
#   Zone Resources: Include -> "All zones from an account" -> your account.
#     (EXACTLY that option — it's what allows CREATING new zones and covers
#     every future domain. A specific-zones list breaks each new site.)
#   No Registrar permission: the API can't buy new domains anyway.
CLOUDFLARE_API_TOKEN=
#   GET ACCOUNT ID: dashboard -> any domain -> right sidebar "Account ID",
#   or copy it from the URL: dash.cloudflare.com/<account_id>/...
CLOUDFLARE_ACCOUNT_ID=

# ==================== Cloudflare R2 (Litestream backups) ====================
# A bucket is created automatically PER SITE (named after the domain,
# dots -> hyphens, e.g. example-com). Requires CLOUDFLARE_API_TOKEN to also
# have the Account / Workers R2 Storage / Edit permission.
# NEVER add lifecycle rules to these buckets — silently breaks restores.
# MUST be the same value as CLOUDFLARE_ACCOUNT_ID — it forms the S3 endpoint
# <account_id>.r2.cloudflarestorage.com (a wrong id fails TLS handshake).
R2_ACCOUNT_ID=
#   GET KEYS: dashboard -> R2 -> API dropdown (top right) -> Manage API
#   tokens -> Create API token -> permission "Object Read & Write", scope
#   "Apply to all buckets in this account" (MUST be account-wide so one key
#   pair covers every future per-site bucket). On the confirmation screen,
#   scroll to "Use the following credentials for S3 clients" and copy THOSE
#   two values — NOT the "Token value" above them (a token value here causes
#   SignatureDoesNotMatch). Shown only once.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# =============================== GitHub =====================================
GITHUB_USER=
#   GET TOKEN: github.com -> Settings -> Developer settings ->
#   Personal access tokens -> Tokens (classic) -> Generate new token.
#   Scopes: repo, write:packages. (Classic token — ghcr.io push needs it.)
#   Used by `gh` for repo creation and as the Kamal registry password.
GITHUB_TOKEN=

# ============================== Postmark ====================================
#   SERVER TOKEN (sends mail): account.postmarkapp.com -> Servers -> pick your
#   shared server (one server for all sites) -> API Tokens tab.
POSTMARK_SERVER_TOKEN=
#   ACCOUNT TOKEN (adds/verifies sender domains — the skill automates DKIM +
#   return-path DNS per new domain): account.postmarkapp.com -> profile icon
#   (top right) -> API Tokens -> Account API token.
POSTMARK_ACCOUNT_TOKEN=
# From address per site defaults to hello@<domain> once the domain verifies.

# ========================= Admin notifications ==============================
# Where "new signup" emails go.
ADMIN_EMAIL=

# =============================== PostHog ====================================
# One PostHog PROJECT PER SITE: the skill creates the project via API on each
# run and wires that project's phc_ key into the site. So this file holds a
# PERSONAL key, not a project key.
#   GET KEY: eu.posthog.com -> click your avatar -> Personal API keys ->
#   Create key, scopes: organization:read + project:write (starts with phx_).
#   NOTE: multiple projects require a paid PostHog Cloud plan; on the free
#   tier set POSTHOG_SHARED_PROJECT_KEY instead and all sites share it.
POSTHOG_PERSONAL_API_KEY=
# Optional fallback: a phc_ project key every site shares (free tier).
POSTHOG_SHARED_PROJECT_KEY=
# EU region by default; use https://us.i.posthog.com if your org is US.
POSTHOG_HOST=https://eu.i.posthog.com

# ========================= Sentry (error tracking) ==========================
# Free tier: 5k errors/mo, unlimited projects. One project is created PER
# SITE via API; the app sends errors only (no tracing) to stay free.
#   GET TOKEN: sentry.io -> Settings -> Auth Tokens (organization tokens) ->
#   Create, scopes: project:write, project:read, org:read.
#   OPTIONAL: leave blank to skip monitoring.
SENTRY_AUTH_TOKEN=
#   Your org slug, from the URL: sentry.io/organizations/<slug>/
SENTRY_ORG=
# Team slug for new projects; defaults to the org slug if blank.
SENTRY_TEAM=

# ============================== sender.net ==================================
#   GET TOKEN: app.sender.net -> Settings -> API access tokens -> Create.
SENDER_API_TOKEN=
# Optional: an existing subscriber group ID. Leave blank and the skill
# creates a group named after each new domain via the Sender API.
#   (Existing group IDs are visible in the group's URL in the Sender UI, or
#   via: scripts/sender.sh list-groups)
SENDER_GROUP_ID=

# =============================== Stripe =====================================
#   GET KEY: dashboard.stripe.com -> Developers -> API keys, LIVE mode ->
#   Create restricted key (rk_live_...) with Write on exactly:
#     Checkout Sessions, Core/Products, Billing/Prices, Webhook Endpoints
#   (write covers read; everything else None). A restricted key works
#   anywhere a secret key does. No publishable key is needed — the app uses
#   Stripe-hosted Checkout (server-side redirect, no Stripe.js).
STRIPE_SECRET_KEY=
# Per-site values are NOT set here: the webhook signing secret and the
# sample product/price are created automatically per site (or pass an
# existing STRIPE_PRICE_ID when the skill asks).
