<h1>Sign in</h1>

<% flash.each do |type, msg| %>
  <p><%= msg %></p>
<% end %>

<%= form_with url: auth_path, method: :post do |f| %>
  <%= f.email_field :email, placeholder: "you@example.com", required: true %>
  <label><%= f.check_box :newsletter, {}, "1", "0" %> Also subscribe to the newsletter</label>
  <%= f.submit "Email me a sign-in link" %>
<% end %>
